datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Модели для NextAuth (Авторизация через Discord)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- ТВОИ МОДЕЛИ ДЛЯ МАРКЕТИНГОВОЙ ВИТРИНЫ ---

// Услуги компании (Каталог)
model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  priceFrom   String
  createdAt   DateTime @default(now())
  leads       Lead[]
}

// Статьи (Блог)
model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   // Краткое описание для карточки
  content     String   // Полный текст статьи
  readTime    String   // Время чтения (например, "5 мин")
  createdAt   DateTime @default(now())
}

// Входящие заявки (Лиды)
model Lead {
  id          String   @id @default(cuid())
  name        String
  contact     String   // Телефон или Telegram
  message     String?  // Дополнительный комментарий
  serviceId   String?  // К какой услуге привязана заявка (если выбрана)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}
