datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 🛠️ БЛОК 1. РАЗДЕЛ «УСЛУГИ» (SERVICES)
// ==========================================

// Направления услуг (Категории: seo, site, smm, serm...)
model ServiceCategory {
  id           String          @id @default(cuid())
  slug         String          @unique // ЧПУ: "seo", "site", "smm"
  title        String          // Главный заголовок H1 на странице направления
  templateType String          // Код шаблона в _templates: "SEO", "SITE", "STANDARD"
  
  // SEO-поля
  seoTitle     String          // Метатег Title
  seoDesc      String          // Метатег Description
  
  // Контент страницы в формате JSON (офферы, преимущества, боли)
  content      Json            

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  // Связи
  modules      ServiceModule[] // Список под-услуг (модулей)
}

// Конечные под-услуги (Модули: technical-audit, push-marketing...)
model ServiceModule {
  id           String          @id @default(cuid())
  slug         String          @unique // ЧПУ: "technical-audit", "push-marketing"
  title        String          // Главный заголовок H1 на странице услуги
  templateType String          // Код шаблона в _templates: "PAYMENT", "STANDARD"
  
  // Маркетинговые поля из вашей таблицы
  description  String          // Текстовое описание сути услуги
  price        String          // Цена ("от 15 000 ₽" или "Входит в пакет")
  
  // SEO-поля
  seoTitle     String          
  seoDesc      String          
  content      Json            // Специфические блоки (стек, этапы интеграции)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  
  // Связи
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cases        Case[]          // Кейсы, где применялась эта услуга
}

// ==========================================
// 🎯 БЛОК 2. РАЗДЕЛ «ОТРАСЛЕВЫЕ РЕШЕНИЯ» (SOLUTIONS)
// ==========================================

// Главные Ниши (medicine, construction, beauty...)
model SolutionCategory {
  id              String           @id @default(cuid())
  slug            String           @unique // ЧПУ: "medicine", "construction"
  title           String           // Заголовок H1 (например, "Решения для медицины")
  
  // SEO-поля
  seoTitle        String          
  seoDesc         String          
  content         Json            

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Связи
  subDirections   SolutionTarget[] // Конкретные виды бизнеса внутри ниши
}

// Конкретные виды бизнеса клиентов (стоматологии, онлайн-школы, заводы...)
model SolutionTarget {
  id              String           @id @default(cuid())
  slug            String           @unique // ЧПУ: "stomatology", "online-schools"
  title           String           // Заголовок H1 (например, "Маркетинг для стоматологий")
  templateType    String           // Код из 6 b2b-шаблонов: "PRODUCT", "SERVICE", "ENTERPRISE"...
  
  // Поля из вашей таблицы MedTech
  businessTask    String           // Главная боль / задача бизнеса клиента
  pwaSolution     String           // Ваше точечное PWA-решение под эту боль
  
  // SEO-поля
  seoTitle        String          
  seoDesc         String          
  content         Json            

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Связи
  categoryId      String
  category        SolutionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cases           Case[]           // Кейсы, выполненные в этом виде бизнеса
}

// ==========================================
// 🏆 БЛОК 3. РАЗДЕЛ «КЕЙСЫ» (CASES)
// ==========================================

model Case {
  id              String          @id @default(cuid())
  slug            String          @unique // ЧПУ: "kejs-seo-stomatologiya"
  title           String          // Заголовок H1 кейса
  templateType    String          // "MARKETING" или "DEV"
  
  // SEO-поля
  seoTitle        String          
  seoDesc         String          
  
  // Контент кейса (Блоки: Задача, Решение, Результаты, Скриншоты)
  content         Json            

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // ⚡ СКВОЗНАЯ SEO-ПЕРЕЛИНКОВКА (Связи с услугами и нишами)
  serviceModuleId String?
  serviceModule   ServiceModule?  @relation(fields: [serviceModuleId], references: [id], onDelete: SetNull)
  
  solutionTargetId String?
  solutionTarget   SolutionTarget? @relation(fields: [solutionTargetId], references: [id], onDelete: SetNull)
}

// ==========================================
// 📰 БЛОК 4. РАЗДЕЛ «МЕДИАЦЕНТР» (MEDIA)
// ==========================================

model MediaCategory {
  id              String      @id @default(cuid())
  slug            String      @unique // ЧПУ: "seo", "smm", "site"
  title           String      // Название рубрики
  seoTitle        String
  seoDesc         String

  posts           BlogPost[]
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique // ЧПУ: "kak-uvelichit-konversiyu"
  title           String        // H1 статьи
  excerpt         String        // Краткое описание для карточки превью
  coverImage      String        // Ссылка на обложку в S3-хранилище
  coverImageAlt   String        // SEO альт-текст для Яндекс.Картинок
  
  // SEO-поля
  seoTitle        String
  seoDesc         String
  
  content         Json          // Богатый текст статьи с разметкой
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Связи
  categoryId      String
  category        MediaCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  // Связи с автором (из блока О нас / Команда)
  authorId        String
  author          TeamMember    @relation(fields: [authorId], references: [id])
}

// ==========================================
// 🏢 БЛОК 5. ФАКТОРЫ ДОВЕРИЯ (ABOUT / TEAM)
// ==========================================

model TeamMember {
  id           String     @id @default(cuid())
  slug         String     @unique // ЧПУ: "ivan-ivanov"
  name         String     // Реальное имя сотрудника
  role         String     // Должность: "Тимлид отдела SEO"
  photo        String     // Фото сотрудника
  photoAlt     String     // SEO альт-текст
  bio          String     // Описание опыта (E-E-A-T)
  skills       String[]   // Массив навыков: ["Next.js", "Tailwind"]
  certificates String[]   // Ссылки на сканы дипломов Яндекса/Google
  socials      Json       // Внешние ссылки на авторитетные профили (Habr, VC, GitHub)
  order        Int        @default(0) // Сортировка вывода

  posts        BlogPost[] // Статьи, написанные этим автором (для Google E-E-A-T)
}
