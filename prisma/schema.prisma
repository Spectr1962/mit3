datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js" // УДАЛИЛИ СТРОКУ OUTPUT ТАК КАК ОНА ЛОМАЛА ПУТИ ДЛЯ TSX
}

// 1. Отраслевые хабы-навигаторы (например: /services/site/medicina)
model IndustryHub {
  id        String      @id @default(uuid())
  slug      String      @unique // Транслит названия (например: medicina)
  title     String      // Название для админки и меню (Медицина)
  heroTitle String      // H1 для хаба
  heroDesc  String      
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  niches    NichePage[]
}

// 2. Изолированные посадочные страницы ниш (лендинги)
model NichePage {
  id         String      @id @default(uuid())
  slug       String      @unique // ЧПУ-транслит ниши (например: stomatologiya)
  seoTitle   String      // Мета-тег Title
  seoDesc    String      // Мета-тег Description
  heroTitle  String      // Уникальный H1 для ниши
  painTitle  String      // Заголовок блока болей
  painDesc   String      // Описание Точки А
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  industryId String
  industry   IndustryHub @relation(fields: [industryId], references: [id], onDelete: Cascade)
  services   Service[]
}

// 3. Услуги и ИТ-модули "Шведского стола"
model Service {
  id           String      @id @default(uuid())
  name         String      // Название модуля (например: Модуль "Push-Маркетинг")
  description  String      // Маркетинговая выгода
  type         String      @default("MODULE") // CORE (в базе) или MODULE (допродажа)
  tier         String      @default("BASE") // BASE / BUSINESS / MAX
  setupPrice   Float       // Разовая стоимость запуска
  monthlyPrice Float       // Ежемесячная абонентская плата
  itemLimit    Int         @default(0) // Лимит позиций в прайсе (не более 30 для BASE по ТЗ)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  nicheId      String?
  niche        NichePage?  @relation(fields: [nicheId], references: [id], onDelete: SetNull)
}

// 4. Сквозные лид-формы (Имя + Телефон / Telegram)
model Lead {
  id         String   @id @default(cuid())
  contact    String   // Имя + Контактные данные
  status     String   @default("NEW") // NEW, IN_PROGRESS, COMPLETED
  pageSource String   // Точный URL откуда пришел лид (Параметр Telegram-логирования)
  moduleName String?  // Заполнено, если заявка оставлена на странице модулей
  createdAt  DateTime @default(now())
}
