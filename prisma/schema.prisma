datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Модели для NextAuth (Авторизация через Discord)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- ТВОИ МОДЕЛИ ДЛЯ МАРКЕТИНГОВОЙ ВИТРИНЫ ---

// 1. ВЕРХНИЙ СЛОЙ: НАПРАВЛЕНИЯ
model Category {
  id              String    @id @default(cuid())
  title           String    
  slug            String    @unique 
  shortTitle      String?   // 👇 Быстрое короткое название для мобильного меню (например, "PWA")
  description     String?   @db.Text
  services        Service[] 
  faqItems        FaqItem[] 
  projects        Project[] 
  reviews         Review[]  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt 

  // SEO-БЛОК ДЛЯ НАПРАВЛЕНИЯ
  seoTitle        String?   
  seoDescription  String?   @db.Text 
  seoKeywords     String?   
  h1              String?   
  metaRobots      String    @default("index, follow") 
  canonicalUrl    String?   
  breadcrumbTitle String?   

  // АВТОМАТИЗАЦИЯ SITEMAP (ДЛЯ СВЕРХБЫСТРОЙ ИНДЕКСАЦИИ)
  sitemapPriority  Float     @default(1.0)      // 👇 Приоритет страницы в sitemap.xml (от 0.0 до 1.0)
  sitemapChangefreq String    @default("weekly") // 👇 Как часто обновляется (daily, weekly)

  // КРАСИВЫЕ ССЫЛКИ ДЛЯ МЕССЕНДЖЕРОВ (Open Graph)
  ogTitle         String?   
  ogImage         String?   

  ctaTitle        String?   @default("Обсудить проект")
  ctaDescription  String?   @db.Text
}

// 2. СРЕДНИЙ СЛОЙ: КОНЕЧНЫЕ УСЛУГИ
model Service {
  id              String   @id @default(cuid())
  title           String   
  slug            String   @unique 
  shortTitle      String?  // 👇 Короткое название для хлебных крошек и мобильных экранов
  priceFrom       Int      @default(0) 
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  modules         Module[] 
  faqItems        FaqItem[] 
  projects        Project[] 
  reviews         Review[]  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt 

  // СЕО-ПАРАМЕТРЫ ДЛЯ СТРАНИЦЫ УСЛУГИ
  durationDays    Int      @default(5)  
  techStack       String?  
  readingTime     Int      @default(3)  // 👇 Время чтения страницы в минутах (например, 3 мин) для фактора доверия
  relatedIds      String[] @default([]) 

  // SEO-БЛОК ДЛЯ СТРАНИЦЫ УСЛУГИ
  seoTitle        String?   
  seoDescription  String?   @db.Text 
  seoKeywords     String?   
  h1              String?   
  contentMarkdown String?   @db.Text 
  metaRobots      String    @default("index, follow") 
  canonicalUrl    String?   
  breadcrumbTitle String?   

  // АВТОМАТИЗАЦИЯ SITEMAP
  sitemapPriority  Float     @default(0.8)      // 👇 Приоритет для страниц услуг чуть ниже, чем у хабов
  sitemapChangefreq String    @default("monthly") // 👇 Обновляется реже (monthly)

  // КРАСИВЫЕ ССЫЛКИ ДЛЯ МЕССЕНДЖЕРОВ (Open Graph)
  ogTitle         String?   
  ogImage         String?   

  ctaTitle        String?   @default("Рассчитать стоимость услуги")
  ctaDescription  String?   @db.Text
}

// Статьи (Блог)
model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String   // Краткое описание для карточки
  content     String   // Полный текст статьи
  readTime    String   // Время чтения (например, "5 мин")
  createdAt   DateTime @default(now())
}

// Входящие заявки (Лиды)
model Lead {
  id          String   @id @default(cuid())
  name        String
  contact     String   // Телефон или Telegram
  message     String?  // Дополнительный комментарий
  serviceId   String?  // К какой услуге привязана заявка (если выбрана)
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}
